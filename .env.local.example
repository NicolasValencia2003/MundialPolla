# Copy this file to ".env.local" for local dev, and set the same vars in Vercel
# (Project -> Settings -> Environment Variables) for production.

# --- Supabase (required) ---
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" secret key (NOT the anon key). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin (required) ---
# Password to open the /admin page (manual score entry + match settings).
ADMIN_PASSWORD=change-me

# --- Football API (optional but recommended for auto result) ---
# Free key from https://www.api-football.com/  (api-sports.io)
FOOTBALL_API_KEY=your-api-football-key
# The fixture id for Colombia vs RD Congo. Find it via the API or dashboard.
# If unset, auto-sync is skipped and you use the admin page to enter the score.
FOOTBALL_FIXTURE_ID=

# --- Cron protection (optional) ---
# A random string. Vercel Cron sends it as a Bearer token to /api/sync.
CRON_SECRET=some-long-random-string
